# WxAlerts PWS Gateway daemon (bare-metal install, used by the SD image).
#
# Install:
#   install -m 0755 pwsgw /usr/local/bin/pwsgw
#   useradd --system --home /var/lib/pwsgw --shell /usr/sbin/nologin \
#           --groups plugdev,i2c pwsgw
#   install -m 0644 pwsgw.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now pwsgw
#
# The unit is hardened so a bug in the daemon cannot touch the rest of the
# system. Check the effective exposure with: systemd-analyze security pwsgw

[Unit]
Description=WxAlerts PWS Gateway
Documentation=https://github.com/wxalerts/pws-gateway
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
# The daemon does not call sd_notify yet, so Type=notify would time out.
# Switch to notify once internal/web signals READY=1 after the listener is up.
Type=simple
# The daemon reads and writes its config under the state directory
# (config.json) and takes the data directory from the flag or PWSGW_DATA_DIR.
# The listener falls back to :8443 and :8080 only when it cannot bind the
# privileged ports, which CAP_NET_BIND_SERVICE below prevents.
ExecStart=/usr/local/bin/pwsgw run --data-dir /var/lib/pwsgw
Restart=always
RestartSec=5s
TimeoutStopSec=30s

User=pwsgw
Group=pwsgw
# plugdev matches the group deploy/udev/99-rtl-sdr.rules assigns to the
# dongle, so the daemon can start rtl_433 against it without root.
# i2c gives access to /dev/i2c-1 for the DS3231 and BMP280 pages. The daemon
# talks to gpsd and ModemManager over localhost and D-Bus, never to their ttys.
SupplementaryGroups=plugdev i2c

# systemd creates these with the right owner. The daemon receives their
# paths in $STATE_DIRECTORY, $CONFIGURATION_DIRECTORY, $LOGS_DIRECTORY and
# $RUNTIME_DIRECTORY. The database, outbox and the staged update live under
# the state directory, which is the only persistent path that is writable.
StateDirectory=pwsgw
StateDirectoryMode=0750
ConfigurationDirectory=pwsgw
LogsDirectory=pwsgw
RuntimeDirectory=pwsgw
WorkingDirectory=/var/lib/pwsgw

# Filesystem
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
# The daemon reads the kernel NTP state with a read-only adjtimex call. The
# bounding set below has no CAP_SYS_TIME, so it still cannot set the clock.
ProtectClock=no
ProtectHostname=yes
ProtectProc=invisible
# The platform adapter reads /proc/meminfo and /proc/uptime, which
# ProcSubset=pid would hide. Other users' processes stay invisible.
ProcSubset=all
UMask=0027

# Devices: only USB (the SDR dongles). PrivateDevices would hide them.
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=char-usb_device rw
DeviceAllow=char-i2c rw

# Privileges. CAP_NET_BIND_SERVICE lets the UI listen on 443 as a plain user.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes

# Network: AF_NETLINK is needed to notice dongles being plugged in (udev).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
IPAddressAllow=any

# Syscalls
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallFilter=adjtimex
SystemCallErrorNumber=EPERM

# Resource limits sized for a Pi 3B+ with 1 GB RAM. The SQLite cache and the
# outbox are bounded in the daemon's own config.
MemoryMax=512M
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
