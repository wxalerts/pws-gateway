# udev rules for RTL2832U based SDR dongles used by the WxAlerts PWS Gateway.
#
# Gives the dongle to group plugdev (gid 46 on Debian and Raspberry Pi OS) with
# mode 0660 and tags it as a software radio, so the pwsgw service user and the
# rtl433 container can open it without root. Install to /etc/udev/rules.d/
# and reload: udevadm control --reload-rules && udevadm trigger
#
# The vendor and product ids are the ones librtlsdr recognises. Pair the file
# with deploy/modprobe.d/blacklist-rtl-dvb.conf, otherwise the kernel DVB
# driver still claims the device first.

ACTION!="add|change", GOTO="rtl_sdr_end"
SUBSYSTEM!="usb", GOTO="rtl_sdr_end"

# Generic RTL2832U (RTL-SDR Blog V3 and V4, Nooelec NESDR, most "RTL-SDR" kits)
ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="2832", ENV{ID_SOFTWARE_RADIO}="1", MODE="0660", GROUP="plugdev", TAG+="uaccess"
ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="2838", ENV{ID_SOFTWARE_RADIO}="1", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# Rebranded RTL2832U TV tuners that work as SDRs
ATTRS{idVendor}=="0413", ATTRS{idProduct}=="6680", ENV{ID_SOFTWARE_RADIO}="1", MODE="0660", GROUP="plugdev", TAG+="uaccess"
ATTRS{idVendor}=="0413", ATTRS{idProduct}=="6f0f", ENV{ID_SOFTWARE_RADIO}="1", MODE="0660", GROUP="plugdev", TAG+="uaccess"
ATTRS{idVendor}=="0458", ATTRS{idProduct}=="707f", ENV{ID_SOFTWARE_RADIO}="1", MODE="0660", GROUP="plugdev", TAG+="uaccess"
ATTRS{idVendor}=="0ccd", ATTRS{idProduct}=="00a9", ENV{ID_SOFTWARE_RADIO}="1", MODE="0660", GROUP="plugdev", TAG+="uaccess"
ATTRS{idVendor}=="0ccd", ATTRS{idProduct}=="00b3", ENV{ID_SOFTWARE_RADIO}="1", MODE="0660", GROUP="plugdev", TAG+="uaccess"
