        "\ufb33": "Hebrew Letter Dalet With Dagesh",
        "1": "One",
        "\ud834\udd1e": "Musical Symbol G Clef (U+1D11E, surrogate pair D834 DD1E)",
        "\u0080": "Control",
        "\u00f6": "Latin Small Letter O With Diaeresis"
      },
      "expected": "{\"\\r\":\"Carriage Return\",\"1\":\"One\",\"\":\"Control\",\"ö\":\"Latin Small Letter O With Diaeresis\",\"€\":\"Euro Sign\",\"𝄞\":\"Musical Symbol G Clef (U+1D11E, surrogate pair D834 DD1E)\",\"דּ\":\"Hebrew Letter Dalet With Dagesh\"}"
    },
    {
