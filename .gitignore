# Go
/bin/
/dist/
*.test
*.out
coverage.*

# Web UI. The built bundle is embedded by web/embed.go, which needs the dist
# directory to exist in a clean checkout, so only the .keep marker is tracked.
web/node_modules/
web/dist/*
!web/dist/.keep
web/.vite/

# Local runtime state
*.db
*.db-wal
*.db-shm
/var/
.env
.env.*

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store

# Keys. Never commit private keys. Public keys are pinned under keys/.
*.key
*.pem
!keys/*.pub
